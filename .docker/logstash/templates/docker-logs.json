{
    "index_patterns": [
        "docker-logs-*"
    ],
    "priority": 200,
    "template": {
        "settings": {
            "number_of_replicas": 0
        },
        "mappings": {
            "properties": {
                "app": {
                    "properties": {
                        "context": {
                            "type": "flattened"
                        },
                        "extra": {
                            "type": "flattened"
                        }
                    }
                }
            }
        }
    }
}
